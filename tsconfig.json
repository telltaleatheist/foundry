{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // package.json (the version) and vendor/tesseract/manifest.json (the
    // Tesseract pin) are imported as modules so the bundler INLINES them into
    // the compiled binary — see packages/foundry-core/src/engine/version.ts.
    "resolveJsonModule": true,

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,

    "types": ["bun"]
  },
  // The engine and its tests moved to packages/foundry-core (FOUNDRY-CORE-PLAN
  // step 3), which checks them with these same options in tsconfig.engine.json;
  // `npm run typecheck` runs that program and this one.
  "include": ["tools/**/*.ts"]
}
