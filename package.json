{
  "name": "foundry",
  "version": "0.0.0",
  "private": true,
  "description": "Recast poorly scanned PDFs into clean EPUBs. Pinned Tesseract for segmentation, three LoRA adapters on one shared Qwen3-4B base for labelling, OCR repair and footnote-marker removal.",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "foundry": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --compile --outfile dist/foundry",
    "build:mac-arm64": "bun build src/cli.ts --compile --target=bun-darwin-arm64 --outfile dist/foundry-darwin-arm64",
    "build:mac-x64": "bun build src/cli.ts --compile --target=bun-darwin-x64 --outfile dist/foundry-darwin-x64",
    "build:linux-x64": "bun build src/cli.ts --compile --target=bun-linux-x64 --outfile dist/foundry-linux-x64",
    "build:win-x64": "bun build src/cli.ts --compile --target=bun-windows-x64 --outfile dist/foundry-windows-x64.exe",
    "build:all": "bun run build:mac-arm64 && bun run build:mac-x64 && bun run build:linux-x64 && bun run build:win-x64",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
