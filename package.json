{
  "name": "foundry",
  "version": "0.9.1",
  "private": true,
  "description": "Recast poorly scanned PDFs into clean EPUBs. A document vision model (dots-ocr by default) reads each page whole — locally via MLX, or against any OpenAI-compatible server such as vLLM.",
  "type": "module",
  "module": "src/cli.ts",
  "bin": {
    "foundry": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tools/release-build.sh host",
    "build:mac-arm64": "tools/release-build.sh darwin-arm64",
    "build:mac-x64": "tools/release-build.sh darwin-x64",
    "build:linux-x64": "tools/release-build.sh linux-x64",
    "build:win-x64": "tools/release-build.sh windows-x64",
    "build:all": "tools/release-build.sh",
    "test": "bun test",
    "release:package": "tools/release-package.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
